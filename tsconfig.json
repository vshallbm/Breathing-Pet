{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["chrome", "vite/client", "node"]
  },
  "include": ["src", "tests"],
  "exclude": ["tests/e2e"]
}
